    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Continue reading", "short_name": "Continue", "description": "Open the story you read last", "url": "./?open=continue", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Begin a new story", "short_name": "New story", "description": "Choose a world and begin a new life", "url": "./?open=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
